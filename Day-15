Q-15.Matrix Diagonal Sum Close
#include <stdio.h>

int main() {
    int m, n;

    scanf("%d %d", &m, &n);

    int A[m][n];
    int sum = 0;

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &A[i][j]);

            if (i == j) {
                sum += A[i][j];
            }
        }
    }

    printf("%d", sum);

    return 0;
}
